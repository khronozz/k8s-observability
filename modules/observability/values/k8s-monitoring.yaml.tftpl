# k8s-monitoring (Alloy Operator + collecteurs Alloy), chart v4.x.
# Confirmés par la doc : destinations de type `prometheus` et `loki`, features clusterMetrics / clusterEvents,
# `collectors.<nom>`, presets (clustered, statefulset, singleton, filesystem-log-reader, daemonset),
# champ `collector` par feature, `telemetryServices.kube-state-metrics.deploy`.
# CORRIGÉ après `helm template` (chart 4.5.3) : `destinations` est un OBJET (clé = nom), pas un tableau.
# `podLogsViaLoki` et `clusterEvents` sont acceptés par le schéma et présents dans le rendu.
cluster:
  name: ${cluster_name}

destinations:
  mimir:
    type: prometheus
    url: http://${mimir_gateway}/api/v1/push
  loki:
    type: loki
    url: http://${loki_gateway}/loki/api/v1/push

clusterMetrics:
  enabled: true
  collector: alloy-metrics

clusterEvents:
  enabled: true
  collector: alloy-singleton

podLogsViaLoki:
  enabled: true
  collector: alloy-logs

collectors:
  alloy-metrics:
    presets: [clustered, statefulset]
  alloy-singleton:
    presets: [singleton]
  alloy-logs:
    presets: [filesystem-log-reader, daemonset]

telemetryServices:
  kube-state-metrics:
    deploy: true
